IDD_WEBDAV DIALOGEX 0, 0, 276, 288
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_NOPARENTNOTIFY
CAPTION "Connect to SFTP Server"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "&Connect to: (server/path or server:port/path)", IDC_STATIC,5,5,166,8
    CONTROL         "Auto",IDC_PROTOAUTO,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,176,5,27,10
    CONTROL         "IPv4",IDC_PROTOV4,"Button",BS_AUTORADIOBUTTON,208,5,31,10
    CONTROL         "IPv6",IDC_PROTOV6,"Button",BS_AUTORADIOBUTTON,240,5,31,10
    EDITTEXT        IDC_CONNECTTO,5,15,266,12,ES_AUTOHSCROLL
    LTEXT           "&User name:",IDC_STATIC,5,31,266,8
    EDITTEXT        IDC_USERNAME,5,42,266,12,ES_AUTOHSCROLL
    LTEXT           "&Password:",IDC_STATIC,5,58,61,8
    PUSHBUTTON      "?",IDC_PASSWORDHELP,78,57,12,10
    CONTROL         "Use PuTTY agent (Pageant)",IDC_USEAGENT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,58,122,8
    PUSHBUTTON      "Change password...",IDC_EDITPASS,5,71,266,14,NOT WS_VISIBLE
    EDITTEXT        IDC_PASSWORD,5,68,266,12,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "Protect password with password manager (TC>=7.5)",IDC_CRYPTPASS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,82, 266,10
    GROUPBOX        "Client certificate for &authentication:",IDC_STATIC,5,92,266,60
    LTEXT           "Public key file (*.pub):",IDC_STATIC,10,103,240,8
    EDITTEXT        IDC_PUBKEY,10,112,239,12,ES_AUTOHSCROLL
    PUSHBUTTON      ">>",IDC_LOADPUBKEY,250,112,16,12
    LTEXT           "Private key file (*.pem):",IDC_STATIC,10,126,253,8
    EDITTEXT        IDC_PRIVKEY,10,136,239,12,ES_AUTOHSCROLL
    PUSHBUTTON      ">>",IDC_LOADPRIVKEY,250,136,16,12
    PUSHBUTTON      "?",IDC_CERTHELP,254,100,12,10
    CONTROL         "Compress data with &ZLIB (Warning: connection may fail with some servers)",IDC_COMPRESS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,152,266,10
    CONTROL         "Show entire directory listings in log (for &debugging purposes)",IDC_DETAILED_LOG,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,162,266,10
    CONTROL         "Send command to keep alive connection (seconds):",IDC_KEEP_ALIVE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,172,220,8
    EDITTEXT        IDC_KEEP_ALIVE_SECONDS,236,170,28,12,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Use SCP for data transfers (faster!)",IDC_SCP_DATA,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,182,146,10
    CONTROL         "Use SCP for everything (no SFTP)",IDC_SCP_ALL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,192,146,10
    LTEXT           "System:",IDC_STATIC,155,187,34,8
    COMBOBOX        IDC_SYSTEM,189,185,78,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Encoding (codepage) of file names:",IDC_STATIC,"Static",SS_SIMPLE | WS_GROUP,5,202,140,8
    COMBOBOX        IDC_UTF8,148,199,104,127,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "?",IDC_UTF8HELP,253,200,12,10
    GROUPBOX        " User &rights of newly created files/directories: ",IDC_STATIC,5,212,266,26
    CONTROL         "New files (Upload):",IDC_STATIC,"Static",SS_SIMPLE | WS_GROUP,13,224,70,8
    EDITTEXT        IDC_FILEMOD,87,222,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "New folders:",IDC_STATIC,185,224,47,8
    EDITTEXT        IDC_DIRMOD,236,222,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Proxy settings:",IDC_STATIC,5,241,266,8
    COMBOBOX        IDC_PROXYCOMBO,5,251,244,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      ">>",IDC_PROXYBUTTON,251,250,20,14
    PUSHBUTTON      "Delete last proxy",IDC_DELETELAST,5,266,65,14
    DEFPUSHBUTTON   "OK",IDOK,165,269,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,221,269,50,14
END

